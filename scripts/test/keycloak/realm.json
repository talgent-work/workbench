            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "service-wiki",
      "enabled": true,
      "attributes": {
        "resource_url": "https://wiki.example.com"
      },
      "publicClient": false,
      "secret": "fixture-only",
