{
  "name": "@talgent-work/workbench-contracts",
  "version": "0.0.0",
  "description": "The Talgent Workbench's contracts, generated for TypeScript.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talgent-work/workbench.git",
    "directory": "gen/ts"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "rebuild": "rm -rf dist node_modules/.tmp/tsconfig.tsbuildinfo && pnpm run build",
    "test:runtime": "node scripts/verify-runtime-imports.mjs"
  },
  "exports": {
    "./talgent/*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  }
}
