#!/usr/bin/env bash
# Refuses a push whose commits carry what the public Workbench tree must not
# (scripts/public-tree/check-leaks.py). It checks the pushed commits' trees,
# which Git names on stdin, not the working tree. Enable with
# `make install-hooks`.
set -euo pipefail

exec python3 "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/scripts/public-tree/check-leaks.py" --pushed
