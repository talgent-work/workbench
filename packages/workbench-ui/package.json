{
  "name": "@talgent/workbench-ui",
  "version": "0.0.0",
  "description": "The Talgent Workbench's pages and components, published as TypeScript source for web apps built with Vite.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talgent-work/workbench.git",
    "directory": "packages/workbench-ui"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./assets/*": "./assets/*",
    "./styles/*": "./styles/*",
    "./components/*.css": "./components/*.css",
    "./components/analytics/chart-geometry": "./components/analytics/chart-geometry.ts",
    "./components/analytics/work-usage/turns": "./components/analytics/work-usage/turns.ts",
    "./components/analytics/work-usage/work-status": "./components/analytics/work-usage/work-status.ts",
    "./components/preview/file-format": "./components/preview/file-format.ts",
    "./components/preview/preview-verdict": "./components/preview/preview-verdict.ts",
    "./components/rail/use-expand-on-change": "./components/rail/use-expand-on-change.ts",
    "./components/shell/entry-shell": "./components/shell/entry-shell.ts",
    "./components/shell/reading-context": "./components/shell/reading-context.ts",
    "./components/work-start/start-work-launch-state": "./components/work-start/start-work-launch-state.ts",
    "./components/*": "./components/*.tsx",
    "./hooks/*": "./hooks/*.ts",
    "./lib/*": "./lib/*.ts",
    "./pages/*": "./pages/*.tsx",
    "./test-support/*": "./test-support/*.ts",
    "./vite-preset": "./vite-preset.ts"
  },
  "files": [
    "assets",
    "components",
    "hooks",
    "lib",
    "pages",
    "public",
    "styles",
    "test-support",
    "vite-preset.ts"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.1",
    "@heroui/react": "^3.1.0",
    "@heroui/styles": "^3.1.0",
    "@streamdown/code": "1.1.1",
    "@streamdown/mermaid": "1.0.3",
    "@tanstack/react-query": "^5.99.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.2",
    "streamdown": "2.6.0"
  },
  "peerDependencies": {
    "@talgent/contracts": "*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@talgent/contracts": "github:talgent-work/contracts#v0.5.10&path:/gen/ts",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.1.6",
    "vitest": "^4.1.12"
  }
