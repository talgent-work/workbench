{
  "name": "@talgent/computer",
  "version": "0.1.0",
  "description": "Talgent Computer: registers a machine as a Managed Computer and keeps it connected.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talgent-work/workbench.git",
    "directory": "apps/computer"
  },
  "type": "module",
  "bin": {
    "talgent-computer": "dist/talgent-computer.mjs"
  },
  "files": [
    "dist/talgent-computer.mjs",
    "dist/computer.mjs"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=3000 \"test/**/*.test.ts\"",
    "test:installed": "node test/installed/install-register-online.ts && node test/installed/upgrade-online.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "2.1.266"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "ws": "^8.18.3"
  }
}
