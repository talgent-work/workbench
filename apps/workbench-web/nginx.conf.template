server {
    listen 3000;
    server_name _;
    client_max_body_size 100m;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;
    # Requests reach nginx through the ingress proxy and Envoy, which add a Via header; nginx's
    # default (gzip_proxied off) then sends every bundle uncompressed.
    gzip_proxied any;
    gzip_vary on;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # Vite emits content-hashed bundles directly under /assets/, so the CDN and
    # browsers may keep them forever. A missing file must 404 rather than fall
    # back to index.html, or an edge would cache HTML under a script URL.
    location ~ "^/assets/[^/]+-[A-Za-z0-9_-]{8}\.[a-z0-9]+$" {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Unhashed files copied from public/assets keep their names across releases.
    location /assets/ {
        add_header Cache-Control "public, max-age=86400";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
