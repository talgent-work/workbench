# Placeholders for the deployment's environment, ConfigMap
# workbench-environment. Every core service reads it, kustomization.yaml copies
# the values that live in resource specs, and the deploy scripts read it for
# the database bootstrap. A real deployment never edits this file: its values
# live in the cluster's ConfigMap, or for a first deploy in a file outside the
# repository (scripts/deploy/lib/environment.sh). An overlay adds its own keys
# in its environment.env. Credentials never go here: the MySQL, ClickHouse and
# Redis passwords come from Secrets mysql-auth, clickhouse-auth and redis-auth.
REDIS_ADDR=redis:6379
KAFKA_BROKER=kafka:9092
NATS_URL=nats://nats:4222
CLICKHOUSE_ADDR=clickhouse:9000
CLICKHOUSE_USER=talgent
MYSQL_ADDR=mysql:3306
MYSQL_USER=talgent
ACCOUNT_MYSQL_DATABASE=talgent_account
AGENT_MYSQL_DATABASE=talgent_agent
WORKBENCH_MYSQL_DATABASE=talgent_workbench
# The public HTTPS origin of the Workbench entry, and its host for the routes.
WORKBENCH_ORIGIN=https://workbench.example.com
WORKBENCH_HOST=workbench.example.com
# The identity Account signs with and the gateway's web-auth policy validates;
# Envoy fetches the keys in the cluster, so it need not change with the entry.
ACCOUNT_ISSUER=https://workbench.example.com/auth
# The parent domain the session cookies are set on when several entries share
# one sign-in; empty keeps them on the Workbench host.
ACCOUNT_COOKIE_DOMAIN=
MARKETPLACE_ARCHIVE_BASE_URL=https://workbench.example.com/marketplace/archives
# The NFS export that holds workspaces and Agent HOMEs (PV talgent-nas-root);
# a PV's source never changes in place.
NAS_SERVER=nfs.example.com
NAS_SHARE=/exports/talgent
# Deployment switches. render-k3s.sh adds the matching component of
# components/ for each switch turned away from its default.
# enabled: Agents call the core's public APIs through the entry under their
# own identity; disabled: the entry admits only people there and Agents get no
# address for them (components/core-api-without-agents).
AGENT_CORE_API_ACCESS=enabled
# Empty: the routes serve WORKBENCH_HOST only. A host name: the web-api, auth
# and computer routes serve it too (components/additional-entry-host).
ADDITIONAL_ENTRY_HOST=
# Empty: controlplane reads its defaults only. A profile name: it also reads
# that profile from ConfigMap controlplane-profile
# (components/controlplane-profile).
CONTROLPLANE_PROFILE=
